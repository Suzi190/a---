<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 叙事诗全屏沉浸主题：
         windowFullscreen + MainActivity 的 edge-to-edge 让页面真正铺满整块屏幕（含状态栏/挖孔区），
         app_bg 只是接管动画、转场、系统栏瞬时唤出时的兜底色，不再承担「假装全屏」的职责 -->
    <style name="Theme.StoryPhone" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- 窗口层面直接去掉状态栏占位：content 的可用区域 = 整块屏幕 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 允许内容铺满挖孔屏 / 刘海屏，避免顶部被裁出一条窗口底色缺口 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
